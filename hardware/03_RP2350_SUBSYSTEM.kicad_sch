	(text "SHEET 3: RP2350B Dual-Core MCU Subsystem\\n\\nU6: RP2350B (Cortex-M33 x2, 520KB SRAM)\\nU7: W25Q128JVSIQ 16MB QSPI Flash\\nY1: 12MHz crystal + 15pF load caps\\nJ1: USB-C (UF2 drag-and-drop)\\nSW1: BOOTSEL, SW2: RESET\\nR3-R4: 5.1k USB-C CC pulldowns\\nR5-R6: 27R USB series resistors\\nR8: 10k QSPI CS pull-up"
		(at 30 30 0)
		(effects (font (size 2.0 2.0)) (justify left top))
		(uuid "9e232f84-15b4-4293-916c-b8e92045f5a3")
