FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git make python3 python3-pil ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
RUN git clone --depth 1 --branch 4.6.0 https://github.com/alekmaul/pvsneslib.git pvsneslib
WORKDIR /project/snes
ENV PVSNESLIB_HOME=/opt/pvsneslib
CMD ["make"]
